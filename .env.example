# ------------------------------------------------------------------
# Settings for the SDR agent. Copy to .env and fill in real values:
#     cp .env.example .env
# .env is git-ignored. Never commit real keys or paste them in Slack.
# ------------------------------------------------------------------

# --- Slack (Socket Mode) -------------------------------------------
# Bot token: api.slack.com/apps -> your app -> OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...
# App-level token with connections:write: Basic Information -> App-Level Tokens
SLACK_APP_TOKEN=xapp-...

# --- Supabase --------------------------------------------------------
# Project Settings -> API. Use the service_role key (server-side only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Deepline --------------------------------------------------------
DEEPLINE_API_KEY=

# --- Claude ----------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- HubSpot (Phase 3) -----------------------------------------------
# Private App token with contacts, companies, notes and calls scopes
HUBSPOT_TOKEN=

# --- HeyReach + Instantly (Phase 4) -----------------------------------
HEYREACH_API_KEY=
HEYREACH_LINKEDIN_ACCOUNT_ID=
HEYREACH_NO_ANSWER_CAMPAIGN_ID=
HEYREACH_POST_CALL_CAMPAIGN_ID=
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# --- Behaviour ---------------------------------------------------------
EXPANSION_MAX_PEOPLE=8
EXPANSION_REPEAT_DAYS=30
# Skip pricey phone lookups for titles below this seniority
PHONE_LOOKUP_MIN_SENIORITY=manager
LOG_LEVEL=INFO
